# CodeCage runtime: Python 3.12
# Build context: runtimes/   (podman build -f python/Containerfile runtimes/)

# ---- stage 1: static supervisor binary -----------------------------------
FROM docker.io/library/golang:1.23-alpine AS runner
WORKDIR /src
COPY runner/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /cage-runner .

# ---- stage 2: minimal runtime --------------------------------------------
FROM docker.io/library/python:3.12-alpine
LABEL org.codecage.runtime="python" \
      org.codecage.description="Hardened Python sandbox runtime (no shell, no pip, no apk)"

COPY --from=runner /cage-runner /usr/local/bin/cage-runner

# 1. unprivileged sandbox user  2. strip pip/tests/tkinter  3. remove setuid bits
# 4. delete the package manager, then busybox (the shell and every coreutil).
RUN addgroup -g 10001 sandbox && adduser -D -H -u 10001 -G sandbox -s /sbin/nologin sandbox \
 && rm -rf /usr/local/bin/pip* /usr/local/bin/idle* /usr/local/bin/pydoc* /usr/local/bin/2to3* \
           /usr/local/lib/python3.12/ensurepip /usr/local/lib/python3.12/idlelib \
           /usr/local/lib/python3.12/test /usr/local/lib/python3.12/tkinter \
           /usr/local/lib/python3.12/turtledemo /usr/local/lib/python3.12/lib2to3 \
           /usr/local/lib/python3.12/site-packages/pip* \
 && find / -xdev -perm /6000 -type f -exec chmod a-s {} + \
 && mkdir -p /sandbox && chmod 1777 /sandbox \
 && rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk /var/cache/apk /root /home \
 && /bin/busybox find / -xdev -type l | while read -r l; do \
      case "$(/bin/busybox readlink "$l")" in *busybox) /bin/busybox rm -f "$l";; esac; done \
 && /bin/busybox rm -f /bin/busybox

USER 10001:10001
WORKDIR /sandbox
ENTRYPOINT ["/usr/local/bin/cage-runner"]
